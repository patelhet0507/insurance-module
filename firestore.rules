rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function canWrite() {
      // staff + admin (insurance app); 'editor' kept for legacy rental collections
      return signedIn() && role() in ['admin', 'staff', 'editor'];
    }

    // ---- Users ----
    // Self-service profile doc: signed-in user may read/write only their own.
    // Role can never be self-assigned — only an admin may set it.
    // NOTE: the first user must be promoted to admin manually (console or script),
    // because nobody can self-bootstrap the admin role.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'viewer';
      allow update: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.role == 'viewer' && role() == 'viewer')
        || (request.auth.uid == uid && request.resource.data.role == 'staff' && role() == 'staff')
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ---- Settings (admin only write) ----
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- Insurance app collections: staff+ write, everyone signed-in reads ----
    match /companies/{doc} {
      allow read: if signedIn();
      allow write: if canWrite();
    }
    match /brokers/{doc} {
      allow read: if signedIn();
      allow write: if canWrite();
    }
    match /customers/{doc} {
      allow read: if signedIn();
      allow write: if canWrite();
    }
    match /insuranceTypes/{doc} {
      allow read: if signedIn();
      allow write: if canWrite();
    }
    match /policies/{doc} {
      allow read: if signedIn();
      allow write: if canWrite();
    }
    match /reminders/{doc} {
      allow read: if signedIn();
      allow write: if canWrite();
    }
    match /notifications/{doc} {
      allow read: if signedIn();
      allow write: if canWrite();
    }
    match /activityLogs/{doc} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // ---- Legacy rental collections (kept working) ----
    match /properties/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && role() in ['admin', 'editor'];
    }
    match /tenants/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && role() in ['admin', 'editor'];
    }
    match /agreements/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && role() in ['admin', 'editor'];
    }
    match /activityLog/{docId} {
      allow read: if request.auth != null && isAdmin();
      allow write: if request.auth != null;
    }

    // Team emails
    match /teamEmails/{doc} {
      allow read, write: if request.auth != null && isAdmin();
    }

    // Password reset tokens — only server-side Admin SDK can read/delete
    match /passwordResets/{token} {
      allow read: if false;
      allow create: if false;
      allow delete: if false;
      allow update: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
